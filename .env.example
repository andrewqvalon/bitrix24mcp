# =============================================================================
# Bitrix24 MCP Server configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Auth mode A – OAuth2 (RECOMMENDED)
# Register an app at https://www.bitrix24.ru/apps/add.php to get these values.
# After setting them, call the 'authorize_bitrix24' MCP tool – a Bitrix24
# login popup will open in your browser, and tokens will be saved automatically.
# -----------------------------------------------------------------------------
BITRIX24_CLIENT_ID=local.YOUR_APP_ID
BITRIX24_CLIENT_SECRET=YOUR_APP_SECRET

# Redirect URI must match what you set in your Bitrix24 app settings exactly.
# The default below works for local development.
BITRIX24_REDIRECT_URI=http://localhost:8765/oauth/callback

# -----------------------------------------------------------------------------
# Auth mode B – Incoming webhook (simpler, no app registration needed)
# Format: https://YOUR_DOMAIN.bitrix24.ru/rest/USER_ID/WEBHOOK_TOKEN/
# If both OAuth and webhook are configured, OAuth takes priority.
# -----------------------------------------------------------------------------
# BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_token/

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql://user:password@localhost:5432/bitrix24mcp
# SQLite (convenient for local development):
# DATABASE_URL=sqlite:///bitrix24mcp.sqlite

# -----------------------------------------------------------------------------
# Sync / cache settings
# -----------------------------------------------------------------------------
# How often the background poller re-syncs all entities (seconds). Default: 3600
SYNC_INTERVAL=3600

# Consider cached data fresh if younger than this many seconds. Default: 300
CACHE_TTL=300

# Comma-separated list of entity types to sync: contacts,companies,deals,leads,pipelines,activities
# Defaults to all types when not set.
SYNC_ENTITIES=contacts,companies,deals,leads,pipelines,activities
